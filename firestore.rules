rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      // Use token role if available, otherwise fetch from users collection
      return isAuthenticated() && (request.auth.token.role != null ? request.auth.token.role : getUserData().role);
    }
    
    function isNationalExecutive() {
      return getUserRole() == 'NATIONAL_EXECUTIVE';
    }
    
    function isFieldAcquisition() {
      return getUserRole() == 'FIELD_ACQUISITION';
    }
    
    function isAuditCitizen() {
      return getUserRole() == 'AUDIT_CITIZEN';
    }

    // Lock Checking Helper
    function isRecordLocked(entityId) {
      let lockPath = /databases/$(database)/documents/data_locks/$(entityId + '_ALL');
      return exists(lockPath) && 
             get(lockPath).data.isUnlocked == false && 
             !(getUserRole() in get(lockPath).data.allowedRoles);
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isNationalExecutive() || request.auth.uid == userId;
      allow update: if isNationalExecutive() || request.auth.uid == userId;
      allow delete: if false; // Soft deletes only
    }

    // 2. Roles & Permissions metadata
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isNationalExecutive();
    }

    // 3. Administrative Master Collections (States, Districts, Departments)
    match /states/{stateId} {
      allow read: if isAuthenticated();
      allow write: if isNationalExecutive();
    }
    match /districts/{districtId} {
      allow read: if isAuthenticated();
      allow write: if isNationalExecutive();
    }
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isNationalExecutive();
    }

    // 4. Projects & Villages
    match /projects/{projectId} {
      allow read: if true; // Public access for transparency
      allow create: if isNationalExecutive();
      allow update: if isNationalExecutive() && !isRecordLocked(projectId);
      allow delete: if false; // Soft deletes only
    }
    match /villages/{villageId} {
      allow read: if isAuthenticated();
      allow create: if isNationalExecutive();
      allow update: if isNationalExecutive();
      allow delete: if false;
    }

    // 5. Parcels & Land Details
    match /parcels/{parcelId} {
      allow read: if isAuthenticated() || true; // Public parcel passport needs read
      allow create: if isNationalExecutive();
      allow update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }

    // 6. Affected Families (PAFs) & Landowners
    match /affected_families/{familyId} {
      allow read: if isAuthenticated();
      allow create: if isNationalExecutive();
      allow update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }
    
    match /farmers/{farmerId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }

    // 7. Workflow Events & Statutory Progress
    match /workflow_events/{eventId} {
      allow read: if true;
      allow create: if isNationalExecutive() || isFieldAcquisition();
      allow update: if isNationalExecutive();
      allow delete: if false;
    }

    // 8. Tasks & Approvals
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isNationalExecutive() || isFieldAcquisition();
      allow update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }
    match /approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive();
      allow delete: if false;
    }

    // 9. Documents
    match /documents/{docId} {
      allow read: if isAuthenticated() || true; // Some public docs
      allow create: if isNationalExecutive() || isFieldAcquisition();
      allow update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }

    // 10. Compensation & Disbursements
    match /compensation/{compId} {
      allow read: if isAuthenticated();
      allow create: if isNationalExecutive();
      allow update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }

    // 11. Resettlement & Rehabilitation (R&R)
    match /rr_cases/{rrId} {
      allow read: if isAuthenticated();
      allow create: if isNationalExecutive();
      allow update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }

    // 12. Legal Cases
    match /legal_cases/{caseId} {
      allow read: if isAuthenticated();
      allow create: if isNationalExecutive();
      allow update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }

    // 13. Grievances
    match /grievances/{grievanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isNationalExecutive() || isFieldAcquisition() || resource.data.submittedBy == request.auth.uid;
      allow delete: if false;
    }

    // 14. Field Visits & Field Evidence & Structural Assets
    match /field_visits/{visitId} {
      allow read: if isAuthenticated();
      allow create: if isNationalExecutive() || isFieldAcquisition();
      allow update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }
    match /field_evidence/{evidenceId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }
    match /structural_assets/{assetId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }

    // 15. QR Assets & IoT Devices
    match /qr_assets/{assetId} {
      allow read: if true;
      allow create, update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }
    match /iot_devices/{devId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive();
      allow delete: if false;
    }
    match /iot_events/{evtId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update: if isNationalExecutive();
      allow delete: if false;
    }

    // 16. Intelligence: Bottlenecks, Predictions, Interventions, Simulations, Workload
    match /bottlenecks/{bnId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive();
      allow delete: if false;
    }
    match /predictions/{predId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive();
      allow delete: if false;
    }
    match /interventions/{intId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive();
      allow delete: if false;
    }
    match /simulations/{simId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive();
      allow delete: if false;
    }
    match /officer_workloads/{owId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive() || isFieldAcquisition();
      allow delete: if false;
    }
    
    // Compensation Fairness
    match /compensation_fairness/{cfId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive();
      allow delete: if false;
    }

    // 17. Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strict immutability
    }
    
    match /system/{sysId} {
      allow read: if isAuthenticated();
      allow create, update: if isNationalExecutive();
      allow delete: if false;
    }
  }
}
